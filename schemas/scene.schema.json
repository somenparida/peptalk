{
  "$defs": {
    "CoordinateSystem": {
      "properties": {
        "up_axis": {
          "default": "Z",
          "description": "Vertical axis in 3D space. Standard Member 2 convention is 'Z'.",
          "enum": [
            "Z",
            "Y"
          ],
          "title": "Up Axis",
          "type": "string"
        },
        "horizontal_axes": {
          "default": [
            "X",
            "Y"
          ],
          "description": "Horizontal plane axes. Standard Member 2 convention is ['X', 'Y'].",
          "items": {
            "enum": [
              "X",
              "Y",
              "Z"
            ],
            "type": "string"
          },
          "title": "Horizontal Axes",
          "type": "array"
        }
      },
      "title": "CoordinateSystem",
      "type": "object"
    },
    "Door": {
      "properties": {
        "id": {
          "description": "Unique identifier for the door",
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "wall_id": {
          "description": "ID of the wall containing this door",
          "minLength": 1,
          "title": "Wall Id",
          "type": "string"
        },
        "offset": {
          "description": "Distance in meters from wall start along wall vector to the door start",
          "minimum": 0.0,
          "title": "Offset",
          "type": "number"
        },
        "width": {
          "description": "Door opening width in meters",
          "exclusiveMinimum": 0.0,
          "maximum": 10.0,
          "title": "Width",
          "type": "number"
        },
        "height": {
          "default": 2.1,
          "description": "Door opening height in meters",
          "exclusiveMinimum": 0.0,
          "maximum": 10.0,
          "title": "Height",
          "type": "number"
        }
      },
      "required": [
        "id",
        "wall_id",
        "offset",
        "width"
      ],
      "title": "Door",
      "type": "object"
    },
    "Room": {
      "properties": {
        "id": {
          "description": "Unique identifier for the room",
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Human-readable room name, e.g. 'Living Room'",
          "title": "Name"
        },
        "polygon": {
          "description": "List of 2D [x, y] coordinates forming the room polygon boundary in meters",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "minItems": 3,
          "title": "Polygon",
          "type": "array"
        }
      },
      "required": [
        "id",
        "polygon"
      ],
      "title": "Room",
      "type": "object"
    },
    "Wall": {
      "properties": {
        "id": {
          "description": "Unique identifier for the wall",
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "start": {
          "description": "2D start point [x, y] in meters",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Start",
          "type": "array"
        },
        "end": {
          "description": "2D end point [x, y] in meters",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "End",
          "type": "array"
        },
        "thickness": {
          "default": 0.15,
          "description": "Wall thickness in meters (0 < t <= 2m)",
          "exclusiveMinimum": 0.0,
          "maximum": 2.0,
          "title": "Thickness",
          "type": "number"
        },
        "height": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 20.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Wall height in meters. If omitted, uses global scene wall_height.",
          "title": "Height"
        }
      },
      "required": [
        "id",
        "start",
        "end"
      ],
      "title": "Wall",
      "type": "object"
    },
    "Window": {
      "properties": {
        "id": {
          "description": "Unique identifier for the window",
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "wall_id": {
          "description": "ID of the wall containing this window",
          "minLength": 1,
          "title": "Wall Id",
          "type": "string"
        },
        "offset": {
          "description": "Distance in meters from wall start along wall vector to the window start",
          "minimum": 0.0,
          "title": "Offset",
          "type": "number"
        },
        "width": {
          "description": "Window opening width in meters",
          "exclusiveMinimum": 0.0,
          "maximum": 15.0,
          "title": "Width",
          "type": "number"
        },
        "height": {
          "description": "Window opening height in meters",
          "exclusiveMinimum": 0.0,
          "maximum": 10.0,
          "title": "Height",
          "type": "number"
        },
        "sill_height": {
          "default": 0.9,
          "description": "Sill height from floor level z=0 in meters",
          "maximum": 10.0,
          "minimum": 0.0,
          "title": "Sill Height",
          "type": "number"
        }
      },
      "required": [
        "id",
        "wall_id",
        "offset",
        "width",
        "height"
      ],
      "title": "Window",
      "type": "object"
    }
  },
  "properties": {
    "units": {
      "default": "meters",
      "description": "Measurement units. Standard is 'meters' (or 'm').",
      "title": "Units",
      "type": "string"
    },
    "coordinate_system": {
      "$ref": "#/$defs/CoordinateSystem",
      "description": "Coordinate system conventions (default up_axis='Z', horizontal=['X', 'Y'])"
    },
    "wall_height": {
      "default": 2.8,
      "description": "Default wall height in meters across the scene",
      "exclusiveMinimum": 0.5,
      "maximum": 20.0,
      "title": "Wall Height",
      "type": "number"
    },
    "walls": {
      "description": "List of architectural walls",
      "items": {
        "$ref": "#/$defs/Wall"
      },
      "title": "Walls",
      "type": "array"
    },
    "doors": {
      "description": "List of doors / openings",
      "items": {
        "$ref": "#/$defs/Door"
      },
      "title": "Doors",
      "type": "array"
    },
    "windows": {
      "description": "List of windows / openings",
      "items": {
        "$ref": "#/$defs/Window"
      },
      "title": "Windows",
      "type": "array"
    },
    "rooms": {
      "description": "List of room polygon definitions",
      "items": {
        "$ref": "#/$defs/Room"
      },
      "title": "Rooms",
      "type": "array"
    },
    "metadata": {
      "additionalProperties": true,
      "description": "Arbitrary blueprint metadata (source, designer, scale, date)",
      "title": "Metadata",
      "type": "object"
    }
  },
  "title": "SceneSpecification",
  "type": "object"
}